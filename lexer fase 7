lexer grammar ExprLexer;

AND : 'and' ;
OR : 'or' ;
NOT : 'not' ;
EQ : '=' ;
COMMA : ',' ;
SEMI : ';' ;
LPAREN : '(' ;
RPAREN : ')' ;
LCURLY : '{' ;
RCURLY : '}' ;
COLON : ':' ;
PONTO : '.' ;
AND_E   : '&' ;
OR_O    : '|' ;
ADDITION : '+' ; 
SUBTRACTION : '-' ;
MULTIPLICATION : '*' ;
DIVISION : '/' ;
MODULUS : '%' ;
EXPONENTIATION : '**' ;
FLOOR_DIVISION : '//' ;
EQUAL_TO : '==' ;
NOT_EQUAL_TO : '!=' ;
GREATER_THAN : '>' ;
ARROW : '->' ;
LESS_THAN : '<' ;
GREATER_THAN_OR_EQUAL_TO : '>=' ;
LESS_THAN_OR_EQUAL_TO : '<=' ;
ADDITION_ASSIGNMENT : '+=' ;
SUBTRACTION_ASSIGNMENT : '-=' ;
MULTIPLICATION_ASSIGNMENT : '*=' ;
DIVISION_ASSIGNMENT : '/=' ;
MODULUS_ASSIGNMENT : '%=' ;
EXPONENTIATION_ASSIGNMENT : '**=' ;
FLOOR_DIVISION_ASSIGNMENT : '//=' ;
IMPORT: 'import' ;
ELSE: 'else' ;
IF: 'if' ;
ELIF: 'elif' ;
TRUE: 'true' ;
FALSE: 'false' ;
FROM: 'from' ;
IN: 'in' ;
FOR: 'for' ;
WHILE: 'while' ;
PRINT: 'print' ;
STRING : '"' ( '\\' . | ~['\\\r\n] )* '"' ;
BOOLEAN : ('true' | 'false') ;
DEF: 'def' ;
WITH: 'with' ;
TYPE: 'type' ;
LIST: 'list' ;
STR: 'str' ;
RETURN: 'return' ;
CONTINUE: 'continue' ;
BREAK: 'break' ;
FUNC: 'func' ;

NEWLINE: '\n' ;
TYPES: 'int' | 'float' | 'string' | 'bool' ;

INT: '-'?[0-9]+;
FLOAT: '-'?[0-9]+ '.' [0-9]* | '-'? '.' [0-9]+ ;
// Suporte para números complexos/imaginários (ex: 0j)
IMAGINARY: [0-9]+[jJ] | [0-9]+ '.' [0-9]*[jJ] | '.' [0-9]+[jJ] ;

ID: [a-zA-Z_][a-zA-Z_0-9]* ;

WS: [ \t\r\f]+ -> skip ;
