parser grammar ExprParser;
options { tokenVocab=ExprLexer; }

// Regra de entrada que junta os requisitos da Fase 6 e Fase 7
code : (stat | conditional | func | func_call | loop_while | loop_for)* EOF ;

// Adicionado 'conditional' para permitir blocos if-else aninhados dentro de estruturas
stat: (expr 
     | atribuicao 
     | loop_while 
     | loop_for 
     | return_stat 
     | break_stat 
     | continue_stat
     | conditional
     ) NEWLINE? ;

conditional:
    IF expr COLON NEWLINE? stat*
    (ELIF expr COLON NEWLINE? stat*)*
    (ELSE COLON NEWLINE? stat*)?
;

atribuicao: ID '=' expr ;

// expr atualizada com func_call no topo e suporte a expressões unárias (-x) e imaginários
expr: func_call 
    | ID
    | INT
    | FLOAT
    | IMAGINARY
    | SUBTRACTION expr    // Permite o menos unário inicial (ex: -x)
    | ADDITION expr       // Permite o mais unário inicial
    | expr ADDITION expr
    | expr SUBTRACTION expr
    | expr MULTIPLICATION expr
    | expr DIVISION expr
    | expr COLON expr
    | expr EQ expr
    | LPAREN expr RPAREN
    | expr MODULUS expr
    | expr EXPONENTIATION expr
    | expr FLOOR_DIVISION expr
    | expr EQUAL_TO expr
    | expr NOT_EQUAL_TO expr
    | expr GREATER_THAN expr
    | expr LESS_THAN expr
    | expr GREATER_THAN_OR_EQUAL_TO expr
    | expr LESS_THAN_OR_EQUAL_TO expr
    | expr ADDITION_ASSIGNMENT expr
    | expr SUBTRACTION_ASSIGNMENT expr
    | expr MULTIPLICATION_ASSIGNMENT expr
    | expr DIVISION_ASSIGNMENT expr
    | expr MODULUS_ASSIGNMENT expr
    | expr EXPONENTIATION_ASSIGNMENT expr
    | expr FLOOR_DIVISION_ASSIGNMENT expr
    | expr IMPORT expr
    | expr ELSE expr
    | expr TRUE expr
    | expr FALSE expr
    | expr FROM expr
    | expr IN expr
    | expr FOR expr
    | expr PRINT expr
    | expr DEF expr
    | expr WITH expr
    | expr TYPE expr
    | expr LIST expr
    | expr STR expr
    | expr AND expr
    | expr AND_E expr
    | expr OR_O expr
    | expr PONTO expr
    | expr NOT expr
    | expr OR expr
    | expr ELIF expr
    | func
    | NOT expr
    ; 

parametros_def : (parametro (COMMA parametro)*)? ;
parametro      : ID (COLON TYPES)? ; 

argumentos     : (expr (COMMA expr)*)? ;

// Estruturas de funções (Fase 6)
func       : DEF ID LPAREN parametros_def RPAREN ('->' TYPES)? COLON ;
func_call  : ID LPAREN argumentos RPAREN ;

// Estruturas de repetição (Fase 7)
loop_while : WHILE expr COLON NEWLINE stat+ ; 
loop_for   : FOR LPAREN ID IN expr RPAREN COLON ;

return_stat   : RETURN expr? ;  
break_stat    : BREAK ;
continue_stat : CONTINUE ;
